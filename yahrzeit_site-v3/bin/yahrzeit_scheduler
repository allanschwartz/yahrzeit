#!/usr/bin/env php
<?php
/*
 * NAME
 *      yahrzeit_scheduler
 *
 * DESCRIPTION
 *      Scheduled phase runner for the CBS Yahrzeit Wall.
 *
 *      This script is intended to be run from cron at policy-derived times.
 *      Cron decides when each phase runs; this script decides whether
 *      the requested phase applies today.
 *
 *      The normal-yahrzeit phase is invoked either every Friday or every day,
 *      according to yahrzeitObservance. bin/fix-up-crontab derives its clock
 *      time from the saved fixed-time or sunset-based policy.
 *
 *      Supported phases:
 *
 *          --phase yizkor-on
 *              If today is a configured Yizkor day, run:
 *                  bin/yahrzeit --yizkor
 *              Otherwise do nothing.
 *
 *          --phase yizkor-off
 *              If today is a configured Yizkor day, restore normal lighting:
 *                  bin/yahrzeit
 *              Otherwise do nothing.
 *
 *          --phase yahrzeit
 *              Run normal yahrzeit lighting:
 *                  bin/yahrzeit
 *
 *          --phase cron-refresh
 *              Rebuild moving sunset-based cron times.
 *
 *      The normal scheduled-control path is:
 *
 *          cron
 *              -> bin/yahrzeit_scheduler
 *                  -> bin/yahrzeit
 *                      -> bin/yahrzeit_engine.php
 *                          -> controller command stream
 *                      -> nc
 *                          -> Arduino controller
 *
 * BLUF
 *      cron decides WHEN scheduled phases run.
 *      yahrzeit_scheduler decides WHETHER the requested phase applies today.
 *      yahrzeit decides HOW to run/transmit.
 *      yahrzeit_engine.php decides WHAT names should be lit, audited, or reported.
 *
 *      Manual operator actions and web-page actions should normally call
 *      bin/yahrzeit directly, not this scheduler.
 *
 * HISTORY
 *      Version 1 created for Congregation Beth Sholom, 2007-2008
 *      by Allan M. Schwartz, allanschwartz@sbcglobal.net.
 *
 *      Version 2 was entirely in crontab.
 *      Version 3 modernized for PHP 8 in 2026.
 *
 * COPYRIGHT NOTICE
 *      Copyright (c) 2026, by Allan M. Schwartz.
 *      All rights reserved.
 */

require_once dirname(__DIR__) . "/include/misc.inc.php";
require_once dirname(__DIR__) . "/include/date_support.inc.php";

date_default_timezone_set("America/Los_Angeles");

function scheduler_usage()
{
    global $argv;
    $prog = basename($argv[0]);

    echo "Usage:\n";
    echo "  $prog --phase PHASE [options]\n\n";
    echo "Phases:\n";
    echo "  --phase yizkor-on     Run Yizkor lighting if today is a configured Yizkor day.\n";
    echo "  --phase yizkor-off    Restore normal yahrzeit lighting if today is a configured Yizkor day.\n";
    echo "  --phase yahrzeit      Run normal yahrzeit lighting.\n\n";
    echo "  --phase cron-refresh  Rebuild moving sunset-based cron times.\n\n";
    echo "Options:\n";
    echo "  --dry-run             Show what would be run; do not call bin/yahrzeit.\n";
    echo "  --now 'YYYY-MM-DD HH:MM'\n";
    echo "                        Test as if the current time were the supplied time.\n";
    echo "  --verbose             Print non-action diagnostics.\n";
    echo "  -h, --help            Show this help.\n\n";
    echo "Cron entries are generated from data/minhag.ini by bin/fix-up-crontab.\n";
}

function fail($message)
{
    fwrite(STDERR, "yahrzeit_scheduler: $message\n");
    exit(1);
}

function parse_options($argv)
{
    $opts = array(
        'phase' => '',
        'dry_run' => false,
        'now' => time(),
        'verbose' => false,
    );

    for ($i = 1; $i < count($argv); $i++) {
        $arg = $argv[$i];

        switch ($arg) {
        case '-h':
        case '--help':
            scheduler_usage();
            exit(0);

        case '--dry-run':
            $opts['dry_run'] = true;
            break;

        case '--verbose':
            $opts['verbose'] = true;
            break;

        case '--now':
            $i++;
            if ($i >= count($argv)) {
                fail("--now requires 'YYYY-MM-DD HH:MM'");
            }
            $ts = strtotime($argv[$i]);
            if ($ts === false) {
                fail("invalid --now value: " . $argv[$i]);
            }
            $opts['now'] = $ts;
            break;

        case '--phase':
            $i++;
            if ($i >= count($argv)) {
                fail("--phase requires yizkor-on, yizkor-off, yahrzeit, or cron-refresh");
            }
            $opts['phase'] = $argv[$i];
            break;

        default:
            fail("unknown option: $arg");
        }
    }

    if ($opts['phase'] == '') {
        fail("missing required --phase option");
    }

    switch ($opts['phase']) {
    case 'yizkor-on':
    case 'yizkor-off':
    case 'yahrzeit':
    case 'cron-refresh':
        break;
    default:
        fail("unknown phase: " . $opts['phase']);
    }

    return $opts;
}

function timestamp_line($message)
{
    global $log_now;

    $ts = isset($log_now) ? $log_now : time();
    echo date("Y-m-d H:i:s", $ts) . "  " . $message . "\n";
}

function timestamp_child_output($label, $lines)
{
    foreach ($lines as $line) {
        timestamp_line("$label: $line");
    }
}

function finish_phase($phase, $status, $started_at)
{
    $duration_ms = (int)round((microtime(true) - $started_at) * 1000);
    timestamp_line("END phase=$phase status=$status duration_ms=$duration_ms");
    return $status;
}

function yizkor_reasons_today($minhag, $now)
{
    $reasons = array();

    $today = date('Y-m-d', $now);
    foreach (next_yizkor_observances($minhag, $now) as $observance) {
        if ($observance['date_key'] == $today) {
            $reasons[] = $observance['name'] . ' (' .
                         $observance['observance_date'] . ')';
        }
    }

    return $reasons;
}

function run_yahrzeit_command($args, $reason, $opts)
{
    $cmd = escapeshellarg(__DIR__ . "/yahrzeit");

    foreach ($args as $arg) {
        $cmd .= " " . escapeshellarg($arg);
    }

    timestamp_line("ACTION: $reason");
    timestamp_line("COMMAND: $cmd");

    if ($opts['dry_run']) {
        return 0;
    }

    $output = array();
    exec("YAHRZEIT_LOG_SUMMARY=1 $cmd 2>&1", $output, $rc);
    timestamp_child_output("WRAPPER", $output);

    if ($rc != 0) {
        timestamp_line("ERROR: command exited with status $rc");
    }

    return $rc;
}

/** Refresh moving sunset-based cron times and include its result in this log. */
function refresh_sunset_crontab($minhag, $opts, $force = false)
{
    if (!$force && ($minhag['yahrzeitLightTime'] ?? 'setTime') != 'atSunset') {
        return 0;
    }

    $command = escapeshellarg(__DIR__ . '/fix-up-crontab');
    if ($opts['dry_run']) {
        $command .= ' --dry-run --crontab-file /dev/null';
    }
    timestamp_line("ACTION: refresh next sunset-based cron schedule");
    timestamp_line("COMMAND: $command");
    $output = array();
    exec("$command 2>&1", $output, $status);
    timestamp_child_output("CRONTAB", $output);

    if ($status != 0) {
        timestamp_line("ERROR: crontab refresh exited with status $status");
    }

    return $status;
}

function main($argv)
{
    $opts = parse_options($argv);
    $now = $opts['now'];

    global $log_now;
    $log_now = $now;

    $minhag = read_minhag_ini();
    $phase = $opts['phase'];
    $started_at = microtime(true);

    timestamp_line(
        "START phase=$phase dry_run=" . ($opts['dry_run'] ? 'yes' : 'no')
    );

    if ($phase == 'yahrzeit') {
        $status = run_yahrzeit_command(array(), "normal yahrzeit lighting", $opts);
        if ($status != 0) {
            return finish_phase($phase, $status, $started_at);
        }
        $status = refresh_sunset_crontab($minhag, $opts);
        return finish_phase($phase, $status, $started_at);
    }

    if ($phase == 'cron-refresh') {
        $status = refresh_sunset_crontab($minhag, $opts, true);
        return finish_phase($phase, $status, $started_at);
    }

    $reasons = yizkor_reasons_today($minhag, $now);
    $is_yizkor_day = (count($reasons) > 0);
    $reason_text = $is_yizkor_day ? implode(", ", $reasons) : "not a configured Yizkor day";

    if ($phase == 'yizkor-on') {
        if ($is_yizkor_day) {
            $status = run_yahrzeit_command(array("--yizkor"), "Yizkor lighting on: $reason_text", $opts);
            return finish_phase($phase, $status, $started_at);
        }

        timestamp_line("DECISION: no action; yizkor-on phase, $reason_text");
        return finish_phase($phase, 0, $started_at);
    }

    if ($phase == 'yizkor-off') {
        if ($is_yizkor_day) {
            $status = run_yahrzeit_command(array(), "Yizkor service over; restore normal yahrzeit lighting: $reason_text", $opts);
            return finish_phase($phase, $status, $started_at);
        }

        timestamp_line("DECISION: no action; yizkor-off phase, $reason_text");
        return finish_phase($phase, 0, $started_at);
    }

    fail("unknown phase: $phase");
    return 1;
}

exit(main($argv));

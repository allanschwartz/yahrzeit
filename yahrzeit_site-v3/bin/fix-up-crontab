#!/usr/bin/env php
<?php
/*
 * Install the managed CBS Yahrzeit Wall block in the appliance crontab.
 *
 * The target account is recorded by the appliance installer in
 * /etc/yahrzeit-cron-user. Unrelated crontab entries are preserved. This
 * command never invokes bin/yahrzeit and therefore never contacts the wall
 * controller.
 */

require_once dirname(__DIR__) . "/include/misc.inc.php";
require_once dirname(__DIR__) . "/include/date_support.inc.php";

const CRON_BEGIN = "# BEGIN CBS YAHRZEIT WALL - managed by bin/fix-up-crontab";
const CRON_END = "# END CBS YAHRZEIT WALL";
const CRON_USER_FILE = "/etc/yahrzeit-cron-user";

date_default_timezone_set("America/Los_Angeles");

function cron_fail($message)
{
    fwrite(STDERR, "fix-up-crontab: $message\n");
    exit(1);
}

function cron_usage()
{
    echo "Usage: fix-up-crontab [--dry-run] [--now 'YYYY-MM-DD HH:MM']\n";
    echo "                        [--crontab-file FILE] [--minhag-file FILE]\n\n";
    echo "  --dry-run         Print the proposed crontab without installing it.\n";
    echo "  --summary         Print one result line instead of the managed block.\n";
    echo "  --now TIME        Calculate moving sunset times as of TIME.\n";
    echo "  --crontab-file    Read/write FILE instead of the system crontab (test use).\n";
    echo "  --minhag-file     Read policy overrides from FILE (dry-run/test use).\n";
    echo "  -h, --help        Show this help.\n";
}

function cron_options($argv)
{
    $options = [
        'dry_run' => false,
        'summary' => false,
        'now' => time(),
        'crontab_file' => '',
        'minhag_file' => '',
    ];

    for ($i = 1; $i < count($argv); $i++) {
        switch ($argv[$i]) {
        case '-h':
        case '--help':
            cron_usage();
            exit(0);

        case '--dry-run':
            $options['dry_run'] = true;
            break;

        case '--summary':
            $options['summary'] = true;
            break;

        case '--now':
            if (++$i >= count($argv)) {
                cron_fail("--now requires a date and time");
            }
            $timestamp = strtotime($argv[$i]);
            if ($timestamp === false) {
                cron_fail("invalid --now value: " . $argv[$i]);
            }
            $options['now'] = $timestamp;
            break;

        case '--crontab-file':
            if (++$i >= count($argv)) {
                cron_fail("--crontab-file requires a path");
            }
            $options['crontab_file'] = $argv[$i];
            break;

        case '--minhag-file':
            if (++$i >= count($argv)) {
                cron_fail("--minhag-file requires a path");
            }
            $options['minhag_file'] = $argv[$i];
            break;

        default:
            cron_fail("unknown option: " . $argv[$i]);
        }
    }

    return $options;
}

/** Validate an HTML/INI HH:MM time and return cron minute/hour fields. */
function cron_time_fields($time, $setting)
{
    if (!preg_match('/^(\d{2}):(\d{2})$/', trim((string)$time), $parts)) {
        cron_fail("invalid $setting in data/minhag.ini");
    }
    $hour = (int)$parts[1];
    $minute = (int)$parts[2];
    if ($hour > 23 || $minute > 59 || ($minute % 15) != 0) {
        cron_fail("invalid $setting in data/minhag.ini");
    }
    return [$minute, $hour];
}

/** Validate a supported Yizkor duration and return its length in minutes. */
function cron_duration_minutes($duration)
{
    $durations = [
        ':30' => 30, ':45' => 45, '1:00' => 60, '1:15' => 75,
        '1:30' => 90, '1:45' => 105, '2:00' => 120,
    ];
    $duration = trim((string)$duration);
    if (!isset($durations[$duration])) {
        cron_fail("invalid Yizkor duration in data/minhag.ini");
    }
    return $durations[$duration];
}

/** Return the cron time obtained by adding a duration to a start time. */
function cron_end_time_fields($minute, $hour, $duration)
{
    $end = (($hour * 60) + $minute + cron_duration_minutes($duration)) % (24 * 60);
    return [$end % 60, intdiv($end, 60)];
}

/** Return the next future daily cron time at a sunset-relative offset. */
function cron_sunset_fields($now, $minutes)
{
    if (!preg_match('/^-?\d{1,3}$/', trim((string)$minutes))) {
        cron_fail("invalid sunset offset in data/minhag.ini");
    }
    $minutes = (int)$minutes;
    if ($minutes < -720 || $minutes > 720) {
        cron_fail("invalid sunset offset in data/minhag.ini");
    }

    $candidate = strtotime('today', $now);

    while (true) {
        $sunset = cbs_sunset_timestamp($candidate);
        if ($sunset === false) {
            cron_fail("could not calculate sunset for " . date('Y-m-d', $candidate));
        }

        $scheduled = $sunset + ($minutes * 60);
        if ($scheduled > $now) {
            return [(int)date('i', $scheduled), (int)date('G', $scheduled)];
        }

        $candidate = strtotime('+1 day', $candidate);
    }
}

function cron_shell_quote($value)
{
    return "'" . str_replace("'", "'\\''", $value) . "'";
}

/** Return one scheduler cron line with output appended to automation.log. */
function cron_scheduler_line($minute, $hour, $days, $phase, $site_dir)
{
    return sprintf(
        "%d %d %s cd %s && bin/yahrzeit_scheduler --phase %s >> data/automation.log 2>&1",
        $minute,
        $hour,
        $days,
        cron_shell_quote($site_dir),
        $phase
    );
}

/** Return cron day/month fields for one upcoming observance row. */
function cron_observance_fields($observance)
{
    $timestamp = $observance['timestamp'] ?? 0;
    if (!is_int($timestamp) || $timestamp <= 0) {
        cron_fail("invalid upcoming Yizkor date");
    }
    return date('j n *', $timestamp);
}

/** Return the complete managed cron block for the saved Minhag policy. */
function cron_managed_block($minhag, $now)
{
    $site_dir = realpath(dirname(__DIR__));
    if ($site_dir === false) {
        cron_fail("could not resolve the site directory");
    }

    $lines = [CRON_BEGIN];

    [$festival_on_minute, $festival_on_hour] = cron_time_fields(
        $minhag['yizkorFestivalStartTime'] ?? '',
        'yizkorFestivalStartTime'
    );
    [$festival_off_minute, $festival_off_hour] = cron_end_time_fields(
        $festival_on_minute,
        $festival_on_hour,
        $minhag['yizkorFestivalDuration'] ?? ''
    );
    [$yk_on_minute, $yk_on_hour] = cron_time_fields(
        $minhag['yizkorYomKippurStartTime'] ?? '',
        'yizkorYomKippurStartTime'
    );
    [$yk_off_minute, $yk_off_hour] = cron_end_time_fields(
        $yk_on_minute,
        $yk_on_hour,
        $minhag['yizkorYomKippurDuration'] ?? ''
    );

    foreach (next_yizkor_observances($minhag, $now) as $observance) {
        $days = cron_observance_fields($observance);
        if ($observance['name'] == 'Yom Kippur') {
            $lines[] = cron_scheduler_line($yk_on_minute, $yk_on_hour, $days, 'yizkor-yom-kippur-on', $site_dir);
            $lines[] = cron_scheduler_line($yk_off_minute, $yk_off_hour, $days, 'yizkor-yom-kippur-off', $site_dir);
        } else {
            $lines[] = cron_scheduler_line($festival_on_minute, $festival_on_hour, $days, 'yizkor-festival-on', $site_dir);
            $lines[] = cron_scheduler_line($festival_off_minute, $festival_off_hour, $days, 'yizkor-festival-off', $site_dir);
        }
    }

    $observance = $minhag['yahrzeitObservance'] ?? 'week';
    if (!in_array($observance, ['day', 'week'], true)) {
        cron_fail("invalid yahrzeitObservance in data/minhag.ini");
    }
    $yahrzeit_time_policy = $minhag['yahrzeitLightTime'] ?? 'setTime';
    if (!in_array($yahrzeit_time_policy, ['setTime', 'atSunset'], true)) {
        cron_fail("invalid yahrzeitLightTime in data/minhag.ini");
    }
    if ($yahrzeit_time_policy == 'atSunset') {
        [$yz_minute, $yz_hour] = cron_sunset_fields(
            $now,
            '-' . ltrim((string)($minhag['yahrzeitMinBefore'] ?? 0), '+-')
        );
    } else {
        [$yz_minute, $yz_hour] = cron_time_fields(
            $minhag['yahrzeitStartTime'] ?? '',
            'yahrzeitStartTime'
        );
    }

    // Reapply the selected day/week wall image every evening. This also
    // restores the intended state after electrical noise disturbs a driver.
    $lines[] = cron_scheduler_line($yz_minute, $yz_hour, '* * *', 'yahrzeit', $site_dir);

    // Recalculate the next civil occurrence of each Hebrew-date observance.
    // This is required even when the normal Yahrzeit time is fixed.
    $lines[] = cron_scheduler_line(5, 0, '* * *', 'cron-refresh', $site_dir);

    $lines[] = CRON_END;
    return implode("\n", $lines);
}

/**
 * Replace or append the marked block while preserving unrelated cron lines.
 *
 * Duplicate, unmatched, or incomplete markers are rejected rather than
 * risking an ambiguous crontab rewrite.
 */
function cron_replace_managed_block($current, $managed)
{
    $output = [];
    $inside = false;
    $found_begin = false;
    $found_end = false;

    foreach (preg_split('/\R/', rtrim($current, "\r\n")) as $line) {
        if ($line === CRON_BEGIN) {
            if ($inside || $found_begin) {
                cron_fail("the existing crontab contains duplicate managed blocks");
            }
            $inside = true;
            $found_begin = true;
            $output[] = $managed;
            continue;
        }
        if ($line === CRON_END) {
            if (!$inside) {
                cron_fail("the existing crontab has an unmatched managed-block end marker");
            }
            $inside = false;
            $found_end = true;
            continue;
        }
        if (!$inside) {
            $output[] = $line;
        }
    }

    if ($inside || $found_begin != $found_end) {
        cron_fail("the existing crontab has an incomplete managed block");
    }

    if (!$found_begin && count($output) > 0 && implode('', $output) !== '') {
        $output[] = '';
        $output[] = $managed;
    }
    if (!$found_begin && (count($output) == 0 || implode('', $output) === '')) {
        $output = [$managed];
    }
    return rtrim(implode("\n", $output), "\r\n") . "\n";
}

/**
 * Return the installer-recorded cron owner.
 *
 * Dry-run and file-test modes may fall back to the current account when the
 * installer-owned account file is absent; live installation may not.
 */
function cron_target_user($allow_missing)
{
    if (!is_readable(CRON_USER_FILE)) {
        if ($allow_missing) {
            return cron_current_account();
        }
        cron_fail(CRON_USER_FILE . " is missing; rerun the appliance installer");
    }

    $user = trim((string)file_get_contents(CRON_USER_FILE));
    if (!preg_match('/^[a-z_][a-z0-9_-]*[$]?$/i', $user)) {
        cron_fail("invalid account name in " . CRON_USER_FILE);
    }
    return $user;
}

function cron_current_account()
{
    if (function_exists('posix_geteuid') && function_exists('posix_getpwuid')) {
        $account = posix_getpwuid(posix_geteuid());
        if (is_array($account) && isset($account['name'])) {
            return $account['name'];
        }
    }

    $user = getenv('USER');
    if ($user !== false && preg_match('/^[a-z_][a-z0-9_-]*[$]?$/i', $user)) {
        return $user;
    }

    cron_fail("could not determine the current account");
}

/**
 * Build a crontab read/install command for the configured account.
 *
 * Root uses crontab -u; a non-root caller must already be that account.
 */
function cron_system_command($target_user, $temporary_file = '')
{
    $command = ['crontab'];
    if (function_exists('posix_geteuid') && posix_geteuid() === 0) {
        $command[] = '-u';
        $command[] = $target_user;
    } elseif (cron_current_account() !== $target_user) {
        cron_fail("run this command as root or as the configured cron account: $target_user");
    }

    if ($temporary_file !== '') {
        $command[] = $temporary_file;
    } else {
        $command[] = '-l';
    }

    return implode(' ', array_map('escapeshellarg', $command));
}

/** Read the test file or installed user crontab; no crontab means empty. */
function cron_read_current($options, $target_user)
{
    if ($options['crontab_file'] !== '') {
        return is_file($options['crontab_file'])
            ? (string)file_get_contents($options['crontab_file'])
            : '';
    }

    exec(cron_system_command($target_user) . ' 2>&1', $output, $status);
    if ($status !== 0) {
        $text = implode("\n", $output);
        if (stripos($text, 'no crontab') !== false) {
            return '';
        }
        cron_fail("could not read the crontab: " . ($text ?: "exit status $status"));
    }
    return implode("\n", $output) . (count($output) ? "\n" : '');
}

/** Install content into the test file or configured user's crontab. */
function cron_install($content, $options, $target_user)
{
    if ($options['crontab_file'] !== '') {
        if (file_put_contents($options['crontab_file'], $content) === false) {
            cron_fail("could not write " . $options['crontab_file']);
        }
        return;
    }

    $temporary = tempnam(sys_get_temp_dir(), 'yahrzeit-cron-');
    if ($temporary === false || file_put_contents($temporary, $content) === false) {
        cron_fail("could not create a temporary crontab");
    }

    exec(cron_system_command($target_user, $temporary) . ' 2>&1', $output, $status);
    unlink($temporary);
    if ($status !== 0) {
        cron_fail("could not install the crontab: " . implode("\n", $output));
    }
}

/** Count executable schedule entries in a managed cron block. */
function cron_entry_count($managed)
{
    $count = 0;
    foreach (preg_split('/\R/', trim($managed)) as $line) {
        $line = trim($line);
        if ($line !== '' && !str_starts_with($line, '#')) {
            $count++;
        }
    }
    return $count;
}

function cron_main($argv)
{
    $options = cron_options($argv);
    $file_mode = ($options['crontab_file'] !== '');
    if ($options['minhag_file'] !== '' && !$file_mode) {
        cron_fail("--minhag-file may be used only with --crontab-file");
    }
    $target_user = cron_target_user($options['dry_run'] || $file_mode);
    $minhag = read_minhag_ini();
    if ($options['minhag_file'] !== '') {
        $overrides = parse_ini_file($options['minhag_file']);
        if ($overrides === false) {
            cron_fail("could not read " . $options['minhag_file']);
        }
        $minhag = array_replace($minhag, $overrides);
    }
    $managed = cron_managed_block($minhag, $options['now']);
    $current = cron_read_current($options, $target_user);
    $proposed = cron_replace_managed_block($current, $managed);

    if ($options['dry_run']) {
        echo $proposed;
        return 0;
    }

    if ($proposed === $current) {
        echo "Yahrzeit cron schedule unchanged for $target_user.\n";
        return 0;
    }

    cron_install($proposed, $options, $target_user);
    if ($options['summary']) {
        echo "Updated Yahrzeit cron schedule for $target_user: " .
             cron_entry_count($managed) . " scheduled operations.\n";
        return 0;
    }
    echo "Installed Yahrzeit cron schedule";
    if ($target_user !== '') {
        echo " for $target_user";
    }
    echo ":\n$managed\n";
    return 0;
}

exit(cron_main($argv));

#!/usr/bin/env bash
#
# NAME
#      bin/yahrzeit
#
# DESCRIPTION
#      Main command-line wrapper for the CBS Yahrzeit Wall.
#
#      This is the middle piece in the normal scheduled-control path:
#
#          cron
#              -> bin/yahrzeit_scheduler
#                  -> bin/yahrzeit
#                      -> bin/yahrzeit_engine.php
#                          -> include/yahrzeit_policy.inc.php
#                              -> controller command stream
#                      -> nc
#                          -> Arduino controller
#
#      bin/yahrzeit is the shared execution and transport stage used by the
#      scheduler and web screens. It provides one common path for:
#
#          - normal yahrzeit lighting
#          - Yizkor lighting
#          - all-on / all-off operations
#          - command-stream preview
#          - audit and report modes
#
#      For normal lighting, this script runs bin/yahrzeit_engine.php to generate the
#      line-oriented controller command stream, then transmits that stream to
#      the Arduino controller using nc.
#
#      Report and audit modes also use bin/yahrzeit_engine.php, but do not transmit
#      anything to the controller.
#
#      Direct controller operations --yizkor, --all-on, and --all-off generate
#      their command streams here and transmit directly.
#
# BLUF
#      cron decides WHEN scheduled phases run.
#      yahrzeit_scheduler decides WHETHER the requested phase applies today.
#      yahrzeit decides HOW to run the action and, when appropriate, transmit it.
#      yahrzeit_engine.php decides WHAT names should be lit, audited, or reported.
#
#      This file should not contain calendar or Minhag rules.
#
# EXAMPLES
#      bin/yahrzeit
#      bin/yahrzeit --dry-run
#      bin/yahrzeit --yizkor
#      bin/yahrzeit --all-on
#      bin/yahrzeit --all-off
#      bin/yahrzeit --audit
#      bin/yahrzeit --report week
#      bin/yahrzeit --report month --date 2026-05-25
#
# NOTES
#      Controller host and port are sourced from
#      bin/yahrzeit-controller.conf. Environment variables may override the
#      connection and transport defaults for one invocation.
#
#      State-changing controller operations emit "save".
#
#      This script uses nc for transport.
#
# HISTORY
#      Version 3 created for Congregation Beth Sholom, 2007-2008
#      by Allan M. Schwartz, allanschwartz@sbcglobal.net.
#
# COPYRIGHT NOTICE
#      Copyright (c) 2008, 2026, by Allan M. Schwartz.
#      All rights reserved.

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
YAHRZEIT_DIR="$(cd "$SCRIPT_DIR/.." && pwd)"

PHP_BIN="$YAHRZEIT_DIR/bin/php"

CONTROLLER_CONFIG_FILE="$SCRIPT_DIR/yahrzeit-controller.conf"
if [[ ! -r "$CONTROLLER_CONFIG_FILE" ]]; then
    echo "ERROR: controller configuration is not readable: $CONTROLLER_CONFIG_FILE" >&2
    exit 1
fi

# Preserve one-command environment overrides while loading appliance defaults.
ENV_CONTROLLER_HOST="${CONTROLLER_HOST:-}"
ENV_CONTROLLER_PORT="${CONTROLLER_PORT:-}"
ENV_CONTROLLER_BRIGHTNESS="${CONTROLLER_BRIGHTNESS:-}"
ENV_CONTROLLER_BRIGHTNESS_ALL_ON="${CONTROLLER_BRIGHTNESS_ALL_ON:-}"
ENV_NC_DELAY="${NC_DELAY:-}"
ENV_POST_SEND_DELAY="${POST_SEND_DELAY:-}"
ENV_TIMEOUT_CMD="${TIMEOUT_CMD:-}"
ENV_NC_TIMEOUT="${NC_TIMEOUT:-}"

# This file is owned by the appliance account and is not web-writable.
# shellcheck source=bin/yahrzeit-controller.conf
source "$CONTROLLER_CONFIG_FILE"

CONTROLLER_HOST="${ENV_CONTROLLER_HOST:-${CONTROLLER_HOST:-}}"
CONTROLLER_PORT="${ENV_CONTROLLER_PORT:-${CONTROLLER_PORT:-2001}}"
CONTROLLER_BRIGHTNESS="${ENV_CONTROLLER_BRIGHTNESS:-${CONTROLLER_BRIGHTNESS:-128}}"
CONTROLLER_BRIGHTNESS_ALL_ON="${ENV_CONTROLLER_BRIGHTNESS_ALL_ON:-${CONTROLLER_BRIGHTNESS_ALL_ON:-128}}"
NC_DELAY="${ENV_NC_DELAY:-${NC_DELAY:-0.05}}"
POST_SEND_DELAY="${ENV_POST_SEND_DELAY:-${POST_SEND_DELAY:-0.5}}"
TIMEOUT_CMD="${ENV_TIMEOUT_CMD:-${TIMEOUT_CMD:-timeout}}"
NC_TIMEOUT="${ENV_NC_TIMEOUT:-${NC_TIMEOUT:-10}}"
NC_QUIT_DELAY="${NC_QUIT_DELAY:-1}"

if [[ -z "$CONTROLLER_HOST" || "$CONTROLLER_HOST" =~ [[:space:]] ]]; then
    echo "ERROR: invalid CONTROLLER_HOST in $CONTROLLER_CONFIG_FILE" >&2
    exit 1
fi

if [[ ! "$CONTROLLER_BRIGHTNESS" =~ ^[0-9]+$ ]] ||
   (( CONTROLLER_BRIGHTNESS < 1 || CONTROLLER_BRIGHTNESS > 254 )); then
    echo "ERROR: CONTROLLER_BRIGHTNESS must be from 1 through 254" >&2
    exit 1
fi

if [[ ! "$CONTROLLER_BRIGHTNESS_ALL_ON" =~ ^[0-9]+$ ]] ||
   (( CONTROLLER_BRIGHTNESS_ALL_ON < 1 || CONTROLLER_BRIGHTNESS_ALL_ON > 254 )); then
    echo "ERROR: CONTROLLER_BRIGHTNESS_ALL_ON must be from 1 through 254" >&2
    exit 1
fi

# The PHP command generator reads the normal lighting value from its
# environment. Wall-wide command streams are generated directly below.
export CONTROLLER_BRIGHTNESS

MODE="yahrzeit"
TRANSMIT=1
REPORT_KIND=""
REPORT_DATE=""
DEBUG_LEVEL=""

usage() {
    cat <<'EOF'
Usage:
  yahrzeit [options]

Default:
  yahrzeit
      Run yahrzeit_engine.php, then transmit generated commands.

Modes:
  --yizkor
      Send the current shortcut Yizkor lighting pattern.

  --all-on
      Turn all LEDs on, refresh, and save.

  --all-off
      Turn all LEDs off, refresh, and save.

Reports / dry-run modes:
  --audit
      Run yahrzeit_engine.php audit mode.  Output is printed; nothing is sent to the controller.

  --report KIND
      Run a yahrzeit report.  Output is printed; nothing is sent to the controller.
      KIND values: day, week, next-week, month, next-month.

  --date YYYY-MM-DD
      Optional report date.  Used by report modes; ignored by controller-only modes.

  --debug 40
      Include verbose per-person lighting-decision diagnostics from the engine.

Transmit/control options:
  --dry-run
      Print command stream to stdout instead of sending to controller.

  -h, --help
      Show this help.

Examples:
  yahrzeit
  yahrzeit --dry-run
  yahrzeit --yizkor
  yahrzeit --all-off
  yahrzeit --audit
  yahrzeit --report week
  yahrzeit --report month --date 2026-05-25
EOF
}

php_assistance1() {
    cat >&2 <<EOF
yahrzeit: no usable PHP executable was found.

This command runs yahrzeit_engine.php, which uses PHP Calendar-extension functions
such as gregoriantojd(), jdtojewish(), jewishtojd(), and jdmonthname().

Install PHP, then verify PHP and the Calendar extension:

    php -v
    php -m | grep -i '^calendar$'
    php -r 'echo jdtojewish(gregoriantojd(5,22,2026)), PHP_EOL;'

After PHP is installed, rerun this command.
EOF
}

php_assistance2() {
    local php_cmd="$1"
    cat >&2 <<EOF
yahrzeit: PHP was found, but the PHP Calendar extension is missing.

yahrzeit_engine.php requires PHP Calendar-extension functions such as:

    gregoriantojd()
    jdtojewish()
    jewishtojd()
    jdmonthname()

Install PHP, then verify PHP and the Calendar extension:

    php -m | grep -i '^calendar$'
    php -r 'echo jdtojewish(gregoriantojd(5,22,2026)), PHP_EOL;'
EOF
}

die() {
    echo "yahrzeit: error: $*" >&2
    exit 1
}

set_mode() {
    local new_mode="$1"
    if [[ "$MODE" != "yahrzeit" ]]; then
        die "only one mode may be selected; already selected '$MODE', got '$new_mode'"
    fi
    MODE="$new_mode"
}

while [[ $# -gt 0 ]]; do
    case "$1" in
        --yizkor)
            set_mode "yizkor"
            shift
            ;;
        --all-on)
            set_mode "all-on"
            shift
            ;;
        --all-off)
            set_mode "all-off"
            shift
            ;;
        --audit)
            set_mode "audit"
            TRANSMIT=0
            shift
            ;;
        --date)
            [[ $# -ge 2 ]] || die "--date requires YYYY-MM-DD"
            REPORT_DATE="$2"
            [[ "$REPORT_DATE" =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}$ ]] || \
                die "--date requires YYYY-MM-DD"
            shift 2
            ;;
        --debug)
            [[ $# -ge 2 ]] || die "--debug requires a number"
            DEBUG_LEVEL="$2"
            [[ "$DEBUG_LEVEL" =~ ^[0-9]+$ ]] || die "--debug requires a numeric value"
            shift 2
            ;;
        -h|--help)
            usage
            exit 0
            ;;
        --dry-run)
            TRANSMIT=0
            shift
            ;;
        --report)
            set_mode "report"
            [[ $# -ge 2 ]] || die "--report requires a kind"
            REPORT_KIND="$2"
            case "$REPORT_KIND" in
                day|daily|week|weekly|next-week|month|this-month|next-month)
                    ;;
                *)
                    die "unknown report kind: $REPORT_KIND"
                    ;;
            esac
            TRANSMIT=0
            shift 2
            ;;
        *)
            die "unknown argument: $1"
            ;;
    esac
done

php_works() {
    local candidate="$1"

    [[ -x "$candidate" ]] || return 1
    "$candidate" -v >/dev/null 2>&1 || return 1

    return 0
}

find_php() {
    if php_works "$PHP_BIN"; then
        echo "$PHP_BIN"
        return 0
    fi

    if command -v php >/dev/null 2>&1; then
        local system_php
        system_php="$(command -v php)"

        if php_works "$system_php"; then
            echo "$system_php"
            return 0
        fi
    fi

    return 1
}

php_has_hebrew_calendar() {
    local php_cmd="$1"

    "$php_cmd" -r '
        exit(
            function_exists("gregoriantojd") &&
            function_exists("jdtojewish") &&
            function_exists("jewishtojd") &&
            function_exists("jdmonthname")
            ? 0 : 1
        );
    ' >/dev/null 2>&1
}

find_yahrzeit_php() {
    local php_cmd

    [[ -f "$SCRIPT_DIR/yahrzeit_engine.php" ]] || \
        die "missing $SCRIPT_DIR/yahrzeit_engine.php"

    if ! php_cmd="$(find_php)"; then
        php_assistance1
        exit 1
    fi

    if ! php_has_hebrew_calendar "$php_cmd"; then
        php_assistance2 "$php_cmd"
        exit 1
    fi

    echo "$php_cmd"
}

run_yahrzeitd() {
    local php_cmd

    php_cmd="$(find_yahrzeit_php)"

    if [ -n "${REPORT_DATE:-}" ] && [ -n "${DEBUG_LEVEL:-}" ]; then
        "$php_cmd" "$SCRIPT_DIR/yahrzeit_engine.php" "$@" --date "$REPORT_DATE" -d "$DEBUG_LEVEL"
    elif [ -n "${REPORT_DATE:-}" ]; then
        "$php_cmd" "$SCRIPT_DIR/yahrzeit_engine.php" "$@" --date "$REPORT_DATE"
    elif [ -n "${DEBUG_LEVEL:-}" ]; then
        "$php_cmd" "$SCRIPT_DIR/yahrzeit_engine.php" "$@" -d "$DEBUG_LEVEL"
    else
        "$php_cmd" "$SCRIPT_DIR/yahrzeit_engine.php" "$@"
    fi
}

# -----------------------------------------------------------------------------
# Command-stream emitters
# -----------------------------------------------------------------------------
#
# The following emit_*() functions produce the literal command streams that are
# sent to the Yahrzeit embedded controller.  The final command stream is either
# printed to stdout (--dry-run) or piped through slowcat/nc into the Arduino
# V3 appliance over TCP port 2001.
#
# The embedded controller is instrumented to echo each command it executes, then
# return a result code and the elapsed time for that command.  Depending on the
# command, elapsed time may range from a few microseconds to a few milliseconds.
#
# The blank line after "save" is intentional. It gives the controller and TCP
# connection one more line boundary and keeps the socket open long enough for
# the controller to send back its echo/result/timing output. Do not remove these
# blank lines merely because they look cosmetic.
# -----------------------------------------------------------------------------


emit_yahrzeit() {
    run_yahrzeitd
}

emit_audit() {
    run_yahrzeitd -a
}

emit_report() {
    run_yahrzeitd --report "$REPORT_KIND"
}

emit_yizkor() {
    # Shortcut Yizkor pattern, based on the later nc-era bin/yizkor wrapper.
    # These are the lights panels containing memorial names rather than trying
    # to compute every individual occupied LED from the database.
    cat <<EOF
# yizkor pattern .. most lights are on

all off
all on 1
all on 2
all on 3
all on 4
all on 5
all on 6
all on 7
all on 8
all on 9
all on 10
all off 11
all off 12
all on 13
all on 14
all off 15
all on 16
all on 17
all off 18
all on 19
pixel on 1 1 20
pixel on 2 1 20
pixel on 3 1 20
pixel on 4 1 20
pixel on 5 1 20
pixel on 6 1 20
pixel on 7 1 20
pixel on 8 1 20
pixel on 9 1 20
pixel on 10 1 20
pixel on 11 1 20
pixel on 12 1 20
pixel on 13 1 20
pixel on 14 1 20
pixel on 15 1 20
pixel on 16 1 20
pixel on 17 1 20
pixel on 18 1 20
pixel on 19 1 20
pixel on 20 1 20
pixel on 21 1 20
pixel on 22 1 20
pixel on 1 2 20
pixel on 2 2 20 

all off 21

brightness $CONTROLLER_BRIGHTNESS_ALL_ON
refresh
save

EOF
}

emit_all_on() {
    cat <<EOF
all on
brightness $CONTROLLER_BRIGHTNESS_ALL_ON
refresh
save

EOF
}

emit_all_off() {
    cat <<EOF
all off
brightness $CONTROLLER_BRIGHTNESS
refresh
save

EOF
}

# Dispatch to the selected command-stream emitter.
#
# Argument parsing above selects exactly one MODE.  This function converts that
# mode into the literal controller command stream that should be transmitted.
emit_commands() {
    case "$MODE" in
        yahrzeit)        emit_yahrzeit ;;
        audit)           emit_audit ;;
        report)          emit_report ;;
        yizkor)          emit_yizkor ;;
        all-on)          emit_all_on ;;
        all-off)         emit_all_off ;;
        *)               die "internal error: unknown mode '$MODE'" ;;
    esac
}

# Slowly copy stdin to stdout, preserving line boundaries.
#
# The embedded controller accepts a simple line-oriented command language over
# TCP.  Although most V3 commands execute very quickly, pacing the stream avoids
# overrunning the controller's socket command parser and makes behavior more
# predictable during testing.
slowcat() {
    local delay="$1"
    while IFS= read -r line; do
        printf '%s\n' "$line" || return $?
        sleep "$delay"
    done
    sleep "$POST_SEND_DELAY"
}

# OpenBSD netcat on Ubuntu supports -q, which closes the client a specified
# number of seconds after stdin reaches EOF. The macOS netcat uses -w for its
# final-read timeout instead.
select_nc_quit_option() {
    if [[ "$(uname -s)" == "Darwin" ]]; then
        printf '%s\n' -w
    else
        printf '%s\n' -q
    fi
}

# Record each rejected command when a controller transaction fails. Normally
# the automation log contains only a compact summary; successful command
# results remain represented by the summary counts.
log_controller_failure_results() {
    local response_file="$1"

    awk '
        /\|/ { previous = $0 }
        /^(Eh\?|ERR )/ {
            command = previous
            sub(/^.*\|[[:space:]]*/, "", command)
            printf "CONTROLLER result command=%c%s%c result=%c%s%c\n",
                   39, command, 39, 39, $0, 39
        }
    ' "$response_file" >&2
}

# Either print the generated command stream or transmit it to the controller.
#
# In --dry-run mode, the command stream is simply printed to
# stdout for inspection.
#
# In normal mode, the stream is passed through slowcat and then into nc,
# connecting to the Yahrzeit embedded controller. Scheduler summary mode also
# validates controller result counts and distinguishes transport timeout,
# transport failure, rejected commands, no response, and incomplete response.
transmit_commands() {
    local expected_commands="${1:-0}"

    if [[ "$TRANSMIT" -eq 0 ]]; then
        cat
        return
    fi

    command -v nc >/dev/null 2>&1 || die "nc not found"
    command -v "$TIMEOUT_CMD" >/dev/null 2>&1 || die "$TIMEOUT_CMD not found"

    local summary_mode="${YAHRZEIT_LOG_SUMMARY:-0}"
    local response_file=""
    local nc_quit_option
    nc_quit_option="$(select_nc_quit_option)"
    if [[ "$summary_mode" == "1" ]]; then
        response_file="$(mktemp)"
        echo "TRANSPORT start mode=$MODE host=$CONTROLLER_HOST port=$CONTROLLER_PORT timeout=${NC_TIMEOUT}s quit_delay=${NC_QUIT_DELAY}s expected_commands=$expected_commands"
    fi

    set +e
    if [[ "$summary_mode" == "1" ]]; then
        slowcat "$NC_DELAY" |
            "$TIMEOUT_CMD" "$NC_TIMEOUT" nc "$nc_quit_option" "$NC_QUIT_DELAY" "$CONTROLLER_HOST" "$CONTROLLER_PORT" >"$response_file"
    else
        slowcat "$NC_DELAY" |
            "$TIMEOUT_CMD" "$NC_TIMEOUT" nc "$nc_quit_option" "$NC_QUIT_DELAY" "$CONTROLLER_HOST" "$CONTROLLER_PORT"
    fi
    local status=("${PIPESTATUS[@]}")
    set -e

    local slowcat_status="${status[0]}"
    local transmit_status="${status[1]}"
    local response_lines=0
    local response_bytes=0
    local controller_ok=0
    local controller_errors=0
    if [[ -n "$response_file" ]]; then
        response_lines="$(wc -l <"$response_file" | tr -d ' ')"
        response_bytes="$(wc -c <"$response_file" | tr -d ' ')"
        controller_ok="$(grep -Ec '^OK$' "$response_file" || true)"
        controller_errors="$(grep -Ec '^(Eh\?|ERR )' "$response_file" || true)"
    fi

    if [[ "$transmit_status" -eq 124 ]]; then
        [[ -z "$response_file" ]] || log_controller_failure_results "$response_file"
        [[ -z "$response_file" ]] || rm -f "$response_file"
        echo "ERROR: controller transmit timed out mode=$MODE host=$CONTROLLER_HOST port=$CONTROLLER_PORT timeout=${NC_TIMEOUT}s nc_status=$transmit_status slowcat_status=$slowcat_status response_lines=$response_lines response_bytes=$response_bytes controller_ok=$controller_ok controller_errors=$controller_errors" >&2
        return 124
    fi

    if [[ "$transmit_status" -ne 0 ]]; then
        [[ -z "$response_file" ]] || log_controller_failure_results "$response_file"
        [[ -z "$response_file" ]] || rm -f "$response_file"
        echo "ERROR: controller transmit failed mode=$MODE host=$CONTROLLER_HOST port=$CONTROLLER_PORT nc_status=$transmit_status slowcat_status=$slowcat_status response_lines=$response_lines response_bytes=$response_bytes controller_ok=$controller_ok controller_errors=$controller_errors" >&2
        return "$transmit_status"
    fi

    if [[ "$slowcat_status" -ne 0 ]]; then
        [[ -z "$response_file" ]] || log_controller_failure_results "$response_file"
        [[ -z "$response_file" ]] || rm -f "$response_file"
        echo "ERROR: controller command stream failed mode=$MODE host=$CONTROLLER_HOST port=$CONTROLLER_PORT nc_status=$transmit_status slowcat_status=$slowcat_status response_lines=$response_lines response_bytes=$response_bytes controller_ok=$controller_ok controller_errors=$controller_errors" >&2
        return "$slowcat_status"
    fi

    if [[ "$summary_mode" == "1" && "$controller_errors" -gt 0 ]]; then
        log_controller_failure_results "$response_file"
        rm -f "$response_file"
        echo "ERROR: controller rejected commands mode=$MODE host=$CONTROLLER_HOST port=$CONTROLLER_PORT response_lines=$response_lines response_bytes=$response_bytes controller_ok=$controller_ok controller_errors=$controller_errors" >&2
        return 65
    fi

    if [[ "$summary_mode" == "1" && "$response_lines" -eq 0 ]]; then
        rm -f "$response_file"
        echo "ERROR: controller returned no response mode=$MODE host=$CONTROLLER_HOST port=$CONTROLLER_PORT" >&2
        return 66
    fi

    if [[ "$summary_mode" == "1" && "$controller_ok" -ne "$expected_commands" ]]; then
        log_controller_failure_results "$response_file"
        rm -f "$response_file"
        echo "ERROR: incomplete controller response mode=$MODE host=$CONTROLLER_HOST port=$CONTROLLER_PORT expected_ok=$expected_commands controller_ok=$controller_ok response_lines=$response_lines response_bytes=$response_bytes" >&2
        return 67
    fi

    if [[ "$summary_mode" == "1" ]]; then
        echo "TRANSPORT success mode=$MODE host=$CONTROLLER_HOST port=$CONTROLLER_PORT expected_ok=$expected_commands controller_ok=$controller_ok response_lines=$response_lines response_bytes=$response_bytes controller_errors=$controller_errors"
    fi
    [[ -z "$response_file" ]] || rm -f "$response_file"
    return 0
}

# Generate the stream into a temporary file so scheduler logging can report a
# command count and validate the same number of successful controller replies.
run_logged_operation() {
    local command_file
    local generation_status=0
    local transmit_status=0
    local command_count

    command_file="$(mktemp)"
    emit_commands >"$command_file" || generation_status=$?
    if [[ "$generation_status" -ne 0 ]]; then
        rm -f "$command_file"
        echo "ERROR: command generation failed mode=$MODE status=$generation_status" >&2
        return "$generation_status"
    fi

    command_count="$(awk 'NF && $1 !~ /^#/ { count++ } END { print count + 0 }' "$command_file")"
    echo "COMMANDS generated mode=$MODE count=$command_count"
    transmit_commands "$command_count" <"$command_file" || transmit_status=$?
    rm -f "$command_file"
    return "$transmit_status"
}

# Main pipeline:
#
#   1. Generate the selected controller command stream.
#   2. Either print it (--dry-run) or send it to the embedded controller.
if [[ "${YAHRZEIT_LOG_SUMMARY:-0}" == "1" && "$TRANSMIT" -eq 1 ]]; then
    run_logged_operation
else
    emit_commands | transmit_commands
fi

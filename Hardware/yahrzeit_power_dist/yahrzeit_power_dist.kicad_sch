	(text "All output connector pin 1 = +5V; pin 2 = GND.\n"
		(exclude_from_sim no)
		(at 174.752 129.032 0)
		(effects
			(font
				(size 1.778 1.778)
				(thickness 0.3556)
				(bold yes)
